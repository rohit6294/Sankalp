{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      "**/*.log",
      ".firebaserc",
      ".gitignore",
      ".git/**",
      "**/.git/**",
      "sankalp-evaluator-api/**",
      ".env*",
      "**/*.pem",
      "**/*.key",
      "**/*.crt",
      "**/*.p12",
      "**/*.md",
      "d",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/admin",
        "destination": "/admin/evaluators.html",
        "type": 302
      },
      {
        "source": "/admin/index.html",
        "destination": "/admin/evaluators.html",
        "type": 302
      },
      {
        "source": "/admin/students.html",
        "destination": "/admin/evaluators.html#studentList",
        "type": 302
      },
      {
        "source": "/admin/settings.html",
        "destination": "/admin/evaluators.html#settings",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
