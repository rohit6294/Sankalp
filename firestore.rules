rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────────
    // Students can read their own profile; backend (Admin SDK) handles writes
    // but we also allow direct client writes so profile.html direct-save works
    match /users/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Settings ─────────────────────────────────────────────────────────────
    // Any logged-in student can READ settings (needed for mandatory field check)
    // Only backend Admin SDK can write
    match /settings/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Submissions ───────────────────────────────────────────────────────────
    // Students can only read their own submission; writes go via backend
    match /submissions/{subId} {
      allow read:  if request.auth != null
                   && resource != null
                   && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── Exams ─────────────────────────────────────────────────────────────────
    // Any logged-in user can read active exams (needed for evaluate page)
    match /exams/{examId} {
      allow read:  if request.auth != null;
      allow write: if false;
      // Answer keys are public-readable for logged-in users
      match /answerKeys/{keyId} {
        allow read:  if request.auth != null;
        allow write: if false;
      }
      match /rankTable/{tableId} {
        allow read:  if request.auth != null;
        allow write: if false;
      }
    }

    // ── Announcements ─────────────────────────────────────────────────────────
    match /announcements/{id} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Bookings ──────────────────────────────────────────────────────────────
    match /bookings/{id} {
      allow read:  if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow write:  if false;
    }

    // ── Everything else: deny ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
